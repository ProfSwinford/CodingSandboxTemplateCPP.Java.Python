{
  // FALLBACK ONLY.
  //
  // When "workspaceFolder" in .devcontainer/devcontainer.json works, the
  // editor opens inside student/ and this file is never read -- student/.vscode
  // is the live configuration.
  //
  // It exists for the case where ${localWorkspaceFolderBasename} does not
  // substitute in Codespaces and the editor falls back to the repo root. Then
  // at least the Explorer stays clean and shows only student/.
  //
  // Build and debug configurations deliberately live in ONE place
  // (student/.vscode) so there is no second copy to keep in sync.
  "files.exclude": {
    "**/.devcontainer": true,
    "**/.vscode": true,
    "**/.git": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/requirements.txt": true,
    "**/README.md": true
  }
}
